{
  "expo": {
    "name": "AiConfirma",
    "slug": "agendabot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6C47FF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.agendabot.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6C47FF"
      },
      "package": "com.agendabot.app",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "scheme": "agendabot",
    "experiments": {
      "typedRoutes": true
    }
  }
}
